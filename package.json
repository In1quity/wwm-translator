{
  "name": "wwm-translator",
  "private": true,
  "version": "0.1.29",
  "description": "Repository quality tooling for WWM Translator",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint": "npm run format:check && npm run lint:md",
    "check": "npm run lint"
  },
  "lint-staged": {
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2"
  }
}
